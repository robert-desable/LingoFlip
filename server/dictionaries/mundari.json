  "phrases": [
    {
      "hindi": "क्या तुम्हें अंक करना आता है?",
      "native": "चिकाना अम लेखा रिकाय इतुया?",
      "latin": "Chikana am lekha rikay ituya?",
      "devanagari": "चिकाना अम लेखा रिकाय इतुया?",
      "meaning": "Do you know how to do numbers/math?",
      "pedagogy_tag": "math_fluency"
    },
    {
      "hindi": "क्या तुम्हें अंक करना आता है",
      "native": "चिकाना अम लेखा रिकाय इतुया?",
      "latin": "Chikana am lekha rikay ituya?",
      "devanagari": "चिकाना अम लेखा रिकाय इतुया?",
      "meaning": "Do you know how to do numbers/math?",
      "pedagogy_tag": "math_fluency"
    },
    {
      "hindi": "आप कैसे हैं?",
      "native": "अम चिलिका मेनामा?",
      "latin": "Am chilika menama?",
      "devanagari": "अम चिलिका मेनामा?",
      "meaning": "How are you?",
      "pedagogy_tag": "greeting"
    },
    {
      "hindi": "तुम कैसे हो?",
      "native": "अम चिलिका मेनामा?",
      "latin": "Am chilika menama?",
      "devanagari": "अम चिलिका मेनामा?",
      "meaning": "How are you?",
      "pedagogy_tag": "greeting"
    },
    {
      "hindi": "नमस्ते बच्चों!",
      "native": "जोहार होनको!",
      "latin": "Johar honko!",
      "devanagari": "जोहार होनको!",
      "meaning": "Welcome children!",
      "pedagogy_tag": "classroom_opening"
    },
    {
      "hindi": "आपका नाम क्या है?",
      "native": "अमः नुतूम चिकाना?",
      "latin": "Amah nutum chikana?",
      "devanagari": "अमः नुतूम चिकाना?",
      "meaning": "What is your name?",
      "pedagogy_tag": "icebreaker"
    },
    {
      "hindi": "मेरा नाम ... है।",
      "native": "आइञाः नुतूम ... तना।",
      "latin": "Aiñah nutum ... tana.",
      "devanagari": "आइञाः नुतूम ... तना।",
      "meaning": "My name is ...",
      "pedagogy_tag": "self_introduction"
    },
    {
      "hindi": "सभी बच्चे अपनी किताबें निकालें।",
      "native": "सोबेन होनको आपन पुथि उरुंगपे।",
      "latin": "Soben honko apan puthi urungpe.",
      "devanagari": "सोबेन होनको आपन पुथि उरुंगपे।",
      "meaning": "All children take out your books.",
      "pedagogy_tag": "instruction"
    },
    {
      "hindi": "किताब खोलो और पृष्ठ 10 देखो।",
      "native": "पुथि उगड़पे आर साकाम १० नेलपे।",
      "latin": "Puthi ugarpe ar sakam 10 nelpe.",
      "devanagari": "पुथि उगड़पे आर साकाम १० नेलपे।",
      "meaning": "Open book and look at page 10.",
      "pedagogy_tag": "instruction"
    },
    {
      "hindi": "यहाँ आओ।",
      "native": "नेतरे हिजुमे।",
      "latin": "Netare hijume.",
      "devanagari": "नेतरे हिजुमे।",
      "meaning": "Come here.",
      "pedagogy_tag": "command"
    },
    {
      "hindi": "यहाँ बैठ जाओ।",
      "native": "नेतरे दुबमे।",
      "latin": "Netare dubme.",
      "devanagari": "नेतरे दुबमे।",
      "meaning": "Sit down here.",
      "pedagogy_tag": "command"
    },
    {
      "hindi": "शांत रहो और सुनो।",
